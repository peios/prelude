load(":checks.bzl", "rust_toolchain_inputs")
load(":packaging.bzl", "package_mode")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "rules-rust-system-libraries.patch",
])

config_setting(
    name = "native",
    values = {"define": "peios_native=true"},
)

constraint_setting(
    name = "libc",
    default_constraint_value = ":libc-gnu",
)

constraint_value(
    name = "libc-gnu",
    constraint_setting = ":libc",
)

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ),
)

rust_toolchain_inputs(name = "toolchain-inputs")

filegroup(
    name = "build-files",
    srcs = ["BUILD.bazel"] + glob(["*.bzl"]),
)

config_setting(
    name = "x86_64-unknown-linux-gnu",
    constraint_values = [":libc-gnu"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "x86_64-unknown-linux-musl",
    constraint_values = [":libc-musl"],
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "libc-musl",
    constraint_setting = ":libc",
)

platform(
    name = "musl-platform",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        ":libc-musl",
    ],
)

package_mode(
    name = "package-mode",
    build_setting_default = False,
)
